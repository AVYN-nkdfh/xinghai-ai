{
  "project": "星海工作室机位预约",
  "version": "1.1",
  "referenceMode": true,
  "pages": [
    {
      "id": "parent-booking",
      "path": "/booking",
      "role": "parent",
      "components": ["date-strip", "time-strip", "facing-seat-map", "booking-form", "success-dialog"],
      "states": ["loading", "default", "machine-selected", "booked", "maintenance", "slot-closed", "error", "success"],
      "actions": ["select-date", "select-slot", "select-machine", "submit-booking", "open-admin"],
      "dependencies": ["dist/booking.html", "/booking/booking.js", "/api/booking/availability", "/api/booking/create"]
    },
    {
      "id": "admin-dashboard",
      "path": "/booking#admin",
      "role": "admin",
      "components": ["password-login", "date-strip", "time-strip", "slot-toggle", "facing-seat-map", "machine-actions", "roster"],
      "states": ["logged-out", "login-error", "default", "empty", "booked", "maintenance", "slot-closed"],
      "actions": ["login", "set-maintenance", "set-slot-open", "cancel-booking", "logout"],
      "dependencies": ["dist/booking.html", "/booking/booking.js", "/api/admin/login", "/api/admin/state", "/api/admin/action"]
    }
  ],
  "services": [
    {"id": "postgres", "provider": "Neon", "constraint": "one active booking per date-slot-machine"},
    {"id": "deployment", "provider": "Vercel", "production": "https://xinghai-ai.com/booking"}
  ]
}
